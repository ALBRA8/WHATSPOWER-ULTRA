{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn"],
  "rules": {
    "no-unused-vars": "off",
    "no-unsafe-optional-chaining": "warn",
    "unicorn/no-useless-fallback-in-spread": "off"
  },
  "ignorePatterns": ["dist/**", "node_modules/**"]
}
