PORT=3004
HOST=127.0.0.1
NODE_ENV=production

# ===== IDENTIDADES ADMINISTRATIVAS (obligatorio en producción) =====
# Formato: "clave:organizationId,clave2:organizationId2,claveServicio"
#  - clave:org  → identidad ligada a esa organización (nunca opera otras; el
#                 organizationId SIEMPRE viene de la identidad, nunca del body).
#  - clave sola → identidad de servicio (admin total; debe indicar organizationId).
# Genera claves con: openssl rand -hex 24
ADMIN_API_KEYS=

# ===== WEBHOOKS (fail-closed, contrato v1.1.0 §3) =====
# Ingesta de leads (POST /api/audiences/webhook-lead): HMAC v2 =
# HMAC-SHA256(secreto, timestamp + "." + body) en X-Signature-SHA256 (se acepta prefijo
# v2= o hex desnudo) + X-Timestamp (epoch ms, ventana ±300s) + anti-replay PERSISTENTE
# (SQLite, sobrevive reinicios) + X-Event-Id OBLIGATORIO (idempotencia orgId::eventId).
# Secretos POR ORGANIZACIÓN (obligatorio en producción): el secreto que valida la
# firma VINCULA la organización — un webhook de la org A jamás añade leads a la org B.
WEBHOOK_LEAD_SECRETS=
# (Legado, solo transición) Secreto único: vincula ÚNICAMENTE la org "default".
WEBHOOK_LEAD_SECRET=
# Solo con 'true' se respeta x-forwarded-for para la IP del cliente (contrato §7).
# TRUST_PROXY=false

# ===== CONTRATOS INTERNOS =====
# Daemon WhatsApp de Capa 1 (envío real) y Capa 2A (locks/supresión)
WHATSAPP_DAEMON_URL=http://localhost:3002
AGENTIC_2A_URL=http://localhost:3003
INTERNAL_API_SECRET=
CRM_BASE_URL=http://localhost:3000

# ===== TRANSPORTE DE DESPACHO =====
# daemon (por defecto) | meta_cloud
TRANSPORT_ENGINE=daemon
# Meta Cloud API (solo si TRANSPORT_ENGINE=meta_cloud)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# META_MOCK_MODE=true  → Sala Limpia (simulación Meta, no envía nada real)

# ===== SALVAGUARDA DE DESPACHO REAL =====
# Con false, TODOS los adaptadores BLOQUEAN el envío real (fail-closed).
# Actívala SOLO con autorización expresa del propietario.
ALLOW_REAL_DISPATCH=false
