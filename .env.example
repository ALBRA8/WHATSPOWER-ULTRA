PORT=3004
HOST=127.0.0.1
NODE_ENV=production

# ===== IDENTIDADES ADMINISTRATIVAS (obligatorio en producción) =====
# Formato: "clave:organizationId,clave2:organizationId2,claveServicio"
#  - clave:org  → identidad ligada a esa organización (nunca opera otras; el
#                 organizationId SIEMPRE viene de la identidad, nunca del body).
#  - clave sola → identidad de servicio (admin total; debe indicar organizationId).
# Genera claves con: openssl rand -hex 24
ADMIN_API_KEYS=

# ===== WEBHOOKS (fail-closed) =====
# Ingesta de leads (POST /api/audiences/webhook-lead): HMAC-SHA256 del body crudo
# en X-Signature-SHA256 + X-Timestamp (epoch ms, ventana ±5min, anti-replay).
# Ingesta de leads (POST /api/audiences/webhook-lead) — CONTRATO HMAC v2
# (reparación integral 2026-11-06):
#   X-Timestamp        = epoch ms (ventana ±5min)
#   X-Org-Id           = organización del emisor (registrada abajo)
#   X-Signature-SHA256 = hex(HMAC-SHA256(secreto_de_la_org, `${orgId}.${timestamp}.${body}`))
# El timestamp y la organización quedan LIGADOS a la firma (no pueden sustituirse).
# Anti-replay durable en db/replay-cache.db (sobrevive reinicios; ajusta la ruta
# con REPLAY_DB_PATH si las réplicas comparten disco).
#
# Secretos POR ORGANIZACIÓN (recomendado). Rotación sin interrupción:
#   orgB:secretoActual|secretoAnterior   (el previo se acepta mientras rota)
WEBHOOK_LEAD_SECRETS=
# Compatibilidad v1 (un solo secreto): queda ligado a la org reservada "_legacy"
# y NO puede ligar leads a campañas. Migra a WEBHOOK_LEAD_SECRETS cuanto antes.
WEBHOOK_LEAD_SECRET=

# ===== CONTRATOS INTERNOS =====
# Daemon WhatsApp de Capa 1 (envío real) y Capa 2A (locks/supresión)
WHATSAPP_DAEMON_URL=http://localhost:3002
AGENTIC_2A_URL=http://localhost:3003
# Credenciales de servicio POR ORGANIZACIÓN para consultar locks/supresiones de WHATSPOWER.
# Debe contener exactamente los mismos pares orgId:credencial configurados en
# WHATSPOWER como ORG_SERVICE_CREDENTIALS. Formato: "orgId:credencial,orgId2:credencial2".
# La credencial es distinta de INTERNAL_API_SECRET y CRM_API_KEY; no usar secretos compartidos globales.
WHATSPOWER_ORG_CREDENTIALS=
INTERNAL_API_SECRET=
CRM_BASE_URL=http://localhost:3000
# (tercera reparación 5.A) TODA verificación en Capa 2A envía X-Org-Id con la
# organización de la campaña y VALIDA el eco `organizationId` de la respuesta:
# respuestas sin eco (TENANT_UNVERIFIED) o desajustadas (TENANT_MISMATCH) se
# rechazan (fail-closed); una incompatibilidad de contrato jamás se interpreta
# como resultado de seguridad legítimo.
# Organización de la ejecución piloto supervisada (execute-pilot-single-dispatch)
PILOT_ORG_ID=

# ===== TRANSPORTE DE DESPACHO =====
# daemon (por defecto) | meta_cloud
TRANSPORT_ENGINE=daemon
# Meta Cloud API (solo si TRANSPORT_ENGINE=meta_cloud)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# META_MOCK_MODE=true  → Sala Limpia (simulación Meta, no envía nada real)

# ===== SALVAGUARDA DE DESPACHO REAL =====
# Con false, TODOS los adaptadores BLOQUEAN el envío real (fail-closed).
# Actívala SOLO con autorización expresa del propietario.
ALLOW_REAL_DISPATCH=false

# ===== REPARACIÓN INTEGRAL 2026-11-06 =====
# Ruta del anti-replay durable (default: db/replay-cache.db; ':memory:' solo tests)
REPLAY_DB_PATH=

# ===== (Auditoría A5-06) Variables adicionales usadas por el código =====
# --- Proceso persistente (src/worker-main.ts, src/queue/persistent-worker.ts) ---
WORKER_TICK_MS=30000            # intervalo entre ticks del worker (default 30s)
WORKER_ITEMS_PER_CAMPAIGN=25    # ítems despachados por campaña en cada tick
WORKER_MAX_CAMPAIGNS=10         # máximo de campañas activas atendidas por tick (round-robin por org)
WORKER_STALE_SECONDS=900        # claims DISPATCHING sin latido > este umbral → UNCERTAIN_DISPATCH
BROADCAST_DB_PATH=              # ruta alternativa de la BD de difusión (default db/broadcast.db)

# --- Transporte Meta Cloud POR ORGANIZACIÓN (Oleada 2) ---
META_ORG_NUMBERS=               # índice org→número: "orgA:111000111,orgB:222000222"
META_ORG_CREDENTIALS=           # triples org:phoneNumberId:accessToken (token ≥16 chars; '__legacy__' reservado)
META_GRAPH_VERSION=v21.0        # versión de Graph API (default v21.0)
TRANSPORT_ENGINE=               # meta_cloud → dispatcher por-org; vacío → puente al daemon del CRM
WHATSPOWER_ENABLED=             # true → locks 2A/supresiones vía servicio WHATSPOWER (false solo desarrollo)
CRM_BASE_URL=http://localhost:3000
CRM_INTERNAL_CREDENTIALS=       # {"orgId":"cred"} credenciales de servicio CRM por org

# --- Salvaguardas piloto (jamás activar sin orden expresa del propietario) ---
CONFIRMED_PILOT_EXECUTION=      # true → habilita el despacho piloto puntual (execute-pilot-single-dispatch)
AGENTIC_2A_ENABLED=             # false → desactiva la capa agéntica 2A en este proceso

# (Limpieza A5-06) META_ACCESS_TOKEN / META_PHONE_NUMBER_ID ya NO son vía de
# envío (credenciales globales): quedan listadas solo como obsoletas.
