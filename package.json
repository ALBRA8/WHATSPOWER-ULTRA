  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "WHATSPOWER ULTRA (Nivel 3) — Suite de Difusión Masiva, Chat Marketing y Anti-Ban para CRM ALBRA",
  "copyright": "Copyright (c) 2026 ALBRA",
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "worker": "node --experimental-strip-types src/worker-main.ts",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "node scripts/run-tests.mjs",
    "security:scan": "node scripts/scan-secrets.mjs",
    "tsc": "tsc --noEmit -p tsconfig.json",
