  "type": "module",
  "description": "WHATSPOWER ULTRA (Nivel 3) — Suite de Difusión Masiva, Chat Marketing y Anti-Ban para CRM ALBRA",
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "worker": "node --experimental-strip-types src/worker-main.ts",
